{
  "name": "@godcreator/gwb-unit-folder",
  "version": "0.7.4",
  "author": {
    "name": "godcreator"
  },
  "description": "单元文件夹件：出生证（unit.json）字段表的正本——建单元、现扫容器根读出生证、树里看文件；「当前单元」往外报（unit-folder/selection 事件）。服务 gwbUnitFolder；skill 1 份；命令 11 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "catalog.md",
    "dist",
    "skills",
    "src"
  ],
  "//gwb": "整段没有：窗格件的名字归运行时——node 半调 ctx.gwbShell.describeSelf，格是 apply 里 registerPane 的",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build",
    "publish:dev": "node scripts/publish.ts",
    "publish:release": "node scripts/publish.ts --release"
  },
  "engines": {
    "node": ">=24"
  },
  "//components": "radix / cva / cn 是 shadcn 组件的运行时依赖，但**打进本束**——它们不在 importmap 里，外置成裸名就是运行期炸，所以按判据算 dev。tailwindcss / @tailwindcss/cli 是构建输入；@tailwindcss/node 给 tests/prefix.test.ts 在不带前缀的输入下试编；tw-animate-css 给 animate-in 一族",
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-shared-react": "^0.1.0",
    "@godcreator/gwb-shell": "^0.9.1",
    "@godcreator/gwb-skills": "^0.4.1",
    "@godcreator/gwb-tokens": "^0.1.3",
    "cordis": "^4.0.0-rc.9"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-data": "0.1.2",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-repo-kit": "0.2.0",
    "@godcreator/gwb-settings": "0.2.1",
    "@godcreator/gwb-shared-react": "0.1.0",
    "@godcreator/gwb-shell": "0.9.1",
    "@godcreator/gwb-skills": "0.4.1",
    "@godcreator/gwb-tokens": "0.1.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/node": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "cordis": "4.0.0-rc.9",
    "esbuild": "^0.27.0",
    "lucide-react": "^1.41.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-unit-folder.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
