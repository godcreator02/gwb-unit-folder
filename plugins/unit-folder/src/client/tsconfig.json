{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    // 浏览器侧没有 node 全局：不给空表 @types/node 会被自动收进来，写 process.env 也不报错
    "types": [],
    "noEmit": true,
    // shadcn 添加的组件写的是 @/… 别名。不写 baseUrl：TS 7 已移除它，paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["."]
}
