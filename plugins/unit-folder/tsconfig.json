{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // node 侧、纯逻辑测试与构建脚本的类型检查；输出走 tsconfig.build.json（它的 rootDir 限定在 src）
    "noEmit": true,
    // 给 shadcn CLI 看的 @/ 别名。不写 baseUrl：TS 7 已移除它，paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": ["src/index.ts", "src/scan.ts", "src/browse.ts", "src/current.ts", "src/create.ts", "src/vscode.ts", "src/client/**/*.ts", "tests/**/*.test.ts", "build.ts", "vitest.config.ts"]
}
